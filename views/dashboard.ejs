<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - FieldFlow</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f2a1d; color: #fff; min-height: 100vh; padding: 30px; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .header h1 { color: #4caf50; }
    .nav a { color: #a0c0b0; text-decoration: none; margin-left: 20px; }
    .nav a:hover { color: #4caf50; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .card { background: #1a3a2b; padding: 24px; border-radius: 12px; }
    .card h3 { color: #a0c0b0; font-size: 0.9em; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
    .card .value { font-size: 2.5em; font-weight: 700; color: #4caf50; }
    .section { margin-bottom: 30px; }
    .section h2 { color: #a0c0b0; margin-bottom: 15px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 12px 8px; border-bottom: 1px solid #2a4a3a; }
    th { color: #a0c0b0; font-size: 0.85em; text-transform: uppercase; }
    td { color: #e0f0e8; }
    .status { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 0.85em; font-weight: 500; }
    .status.active { background: #1b5e20; color: #a5d6a7; }
    .status.flagged { background: #b71c1c; color: #ef9a9a; }
    .status.expired { background: #e65100; color: #ffcc80; }
    .btn { display: inline-block; background: #4caf50; color: #fff; padding: 10px 24px; border-radius: 8px; text-decoration: none; font-weight: 500; border: none; cursor: pointer; }
    .btn:hover { background: #388e3c; }
    input, select { background: #1a3a2b; border: 1px solid #2a4a3a; color: #fff; padding: 10px 14px; border-radius: 8px; width: 100%; margin-bottom: 12px; }
    label { color: #a0c0b0; display: block; margin-bottom: 4px; font-size: 0.9em; }
    form { max-width: 500px; }
  </style>
</head>
<body>
  <div class="header">
    <h1>FieldFlow</h1>
    <div class="nav">
      <a href="/">Home</a>
      <a href="#" id="logoutBtn">Logout</a>
    </div>
  </div>

  <div class="cards">
    <div class="card"><h3>Total Batches</h3><div class="value" id="totalBatches">-</div></div>
    <div class="card"><h3>Flagged</h3><div class="value" id="flaggedBatches">-</div></div>
    <div class="card"><h3>Total Scans</h3><div class="value" id="totalScans">-</div></div>
    <div class="card"><h3>Pending Complaints</h3><div class="value" id="pendingComplaints">-</div></div>
  </div>

  <div class="section">
    <h2>Create Batch</h2>
    <form id="batchForm">
      <label>Product Name</label>
      <input name="productName" required>
      <label>Product Type</label>
      <select name="productType" required>
        <option value="fertilizer">Fertilizer</option>
        <option value="pesticide">Pesticide</option>
        <option value="seed">Seed</option>
      </select>
      <label>Manufacturing Date</label>
      <input name="mfgDate" type="date" required>
      <label>Expiry Date</label>
      <input name="expiryDate" type="date" required>
      <label>Quantity</label>
      <input name="quantity" type="number" value="1">
      <label>Supplier ID (optional)</label>
      <input name="supplierId">
      <label>Dealer ID (admin only)</label>
      <input name="dealerId" placeholder="7631a15f-...">
      <button type="submit" class="btn">Create Batch</button>
    </form>
  </div>

  <div class="section" id="qrContainer" style="display:none"></div>

  <div class="section">
    <h2>Recent Batches</h2>
    <table>
      <thead><tr><th>Product</th><th>Type</th><th>QR Code</th><th>Status</th><th>Created</th></tr></thead>
      <tbody id="batchList"></tbody>
    </table>
  </div>

  <script>
    const token = localStorage.getItem('token');
    if (!token) window.location.href = '/';

    async function api(path, opts = {}) {
      opts.headers = { ...opts.headers, 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' };
      const res = await fetch(path, opts);
      if (!res.ok) { if (res.status === 401) { localStorage.removeItem('token'); window.location.href = '/'; } throw await res.json(); }
      return res.json();
    }

    let lastBatchId = null;

    async function loadDashboard() {
      try {
        const stats = await api('/dealers/dashboard');
        document.getElementById('totalBatches').textContent = stats.totalBatches;
        document.getElementById('flaggedBatches').textContent = stats.flaggedBatches;
        document.getElementById('totalScans').textContent = stats.totalScans;
        document.getElementById('pendingComplaints').textContent = stats.pendingComplaints;

        const batches = await api('/batches');
        const tbody = document.getElementById('batchList');
        tbody.innerHTML = batches.map(b => `<tr>
          <td>${b.product_name}</td>
          <td>${b.product_type}</td>
          <td style="font-family:monospace;font-size:0.85em">${b.qr_code}</td>
          <td><span class="status ${b.status}">${b.status}</span></td>
          <td>${new Date(b.created_at).toLocaleDateString()}</td>
        </tr>`).join('');
      } catch(e) { console.error(e); }
    }

    document.getElementById('batchForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(e.target));
      try {
        const batch = await api('/batches', { method: 'POST', body: JSON.stringify(data) });
        lastBatchId = batch.id;
        const qrRes = await api('/batches/' + batch.id + '/qr');
        const qrDiv = document.getElementById('qrContainer');
        qrDiv.style.display = 'block';
        qrDiv.innerHTML = '<h3>QR Code</h3><img src="' + qrRes.qrImage + '" style="width:200px;height:200px;background:#fff;padding:10px;border-radius:8px"><p style="font-family:monospace;font-size:0.85em;color:#a0c0b0;word-break:break-all">Code: ' + batch.qr_code + '</p>';
        alert('Batch created! QR code generated.');
        e.target.reset();
        loadDashboard();
      } catch(err) { alert(err.error || 'Error'); }
    });

    document.getElementById('logoutBtn').addEventListener('click', () => {
      localStorage.removeItem('token');
      window.location.href = '/';
    });

    loadDashboard();
  </script>
</body>
</html>
