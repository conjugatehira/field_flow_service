generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Batch ──
model Batch {
  id            String   @id @default(ulid())
  batchNumber   String   @unique
  productType   String   // "Fertilizer" | "Pesticide" | "Seed"
  productName   String
  quantity      Float
  dealerId      String
  supplierId    String
  mfgDate       DateTime
  expiryDate    DateTime
  qrSignature   String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dealer    Dealer    @relation(fields: [dealerId], references: [id])
  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  events    TraceabilityEvent[]
  complaints Complaint[]

  @@index([dealerId])
  @@index([supplierId])
  @@index([batchNumber])
}

// ── Dealer ──
model Dealer {
  id              String   @id @default(ulid())
  name            String
  phone           String   @unique
  upazila         String
  district        String
  licenseNumber   String   @unique
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())

  batches Batch[]
}

// ── Supplier ──
model Supplier {
  id             String   @id @default(ulid())
  name           String
  licenseNumber  String   @unique
  phone          String
  createdAt      DateTime @default(now())

  batches    Batch[]
  complaints Complaint[]
}

// ── Farmer ──
model Farmer {
  id            String   @id @default(ulid())
  phone         String   @unique
  name          String
  upazila       String
  district      String
  cropType      String
  soilType      String
  languagePref  String   @default("bn")
  createdAt     DateTime @default(now())

  complaints Complaint[]
  scans      ScanEvent[]
}

// ── ScanEvent (offline-safe) ──
model ScanEvent {
  id        String   @id @default(ulid())
  batchId   String
  farmerId  String
  result    String   // "Verified" | "Counterfeit" | "Expired"
  synced    Boolean  @default(false)
  scannedAt DateTime @default(now())
  syncedAt  DateTime?

  batch  Batch  @relation(fields: [batchId], references: [id])
  farmer Farmer @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([batchId])
  @@index([synced])
}

// ── Complaint ──
model Complaint {
  id          String   @id @default(ulid())
  batchId     String
  farmerId    String
  status      String   @default("Pending")
  routedTo    String   // "Dealer" | "Supplier"
  description String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batch    Batch    @relation(fields: [batchId], references: [id])
  farmer   Farmer   @relation(fields: [farmerId], references: [id])
  supplier Supplier @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([status])
}

// ── AdvisoryRule ──
model AdvisoryRule {
  id                String @id @default(ulid())
  cropType          String
  soilType          String
  weatherCondition  String
  messageTemplateBn String
  messageTemplateEn String
  priority          Int    @default(3)

  @@unique([cropType, soilType, weatherCondition])
}

// ── TraceabilityEvent ──
model TraceabilityEvent {
  id        String   @id @default(ulid())
  batchId   String
  actorType String   // "Supplier" | "Dealer" | "Farmer"
  actorId   String
  eventType String
  location  String?
  metadata  Json?
  timestamp DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([actorType, actorId])
}
